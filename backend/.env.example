# Copy this file to `.env` and fill in your values.

# --- Database ---
# Connection string for PostgreSQL (>= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Email (Resend) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# The email address that receives contact & registration notifications.
MAIL_TO="alex@kleine-musikschule.de"

# The sender address shown to customers (must be verified in Resend).
MAIL_FROM="Kleine Musikschule <onboarding@resend.dev>"

# Reply-to address for auto-reply emails. Defaults to MAIL_TO if not set.
# MAIL_REPLY_TO="alex@kleine-musikschule.de"
